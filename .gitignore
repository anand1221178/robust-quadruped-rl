# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv

# Large experiment files (keep these out - they're huge!)
experiments/*/checkpoints/
experiments/*/tensorboard/
experiments/*/models/*.zip
experiments/*/vec_normalize.pkl
*.pt
*.pth

# But DO track experiment configs and results
!experiments/*/config.yaml
!experiments/*/eval/
!experiments/*/action_analysis.png
!experiments/*/robot_demo.mp4

# Logs (these can be large)
*.log
logs/multiseed/
wandb/offline-run-*
wandb/run-*/files/
wandb/run-*/logs/

# But keep wandb run info
!wandb/run-*/run-*.wandb

# Tensorboard
runs/
tensorboard/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Temporary files
*.tmp
*.bak
*.wandb

# Test and debug scripts
test_*.py
debug_*.py
*_FIXED.py
check_*.py

# Archive folder (large files moved during cleanup)
archive/

# Done folder (contains large model files and evaluation materials)
done/
# Specifically exclude the baseline model
done/ppo_baseline_ueqbjf2x/

# Video files and Videos folder (large - keep local only)
Videos/
*.mp4
*.avi
*.mov
*.mkv

# But keep small demo videos in experiments
!experiments/*/robot_demo.mp4

#Remove claude.md
CLAUDE.md

# LaTeX build artifacts
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.synctex.gz